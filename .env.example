# Container timezone (used for correct timestamp in logs)
TZ=UTC

# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=123456789:AAExampleTokenOfYourBotXXXXXXXXXXXXXXXXXX

# Admin's Telegram Chat ID
ADMIN_CHAT_ID=123456789

# API URL for virtual server management
API_URL=https://api.vps.example.com/server/1234567

# Access token for the VPS API
API_TOKEN=abcde12345abcde12345abcde12345abcde12345abcde12345abcde12345abcde1234

# Minecraft server address (IP or domain)
SERVER_ADDRESS=minecraft.example.com

# VPS server ID for API_URL substitution (currently not used)
# API_SERVER_ID=1234567